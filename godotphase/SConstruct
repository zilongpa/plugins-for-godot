#!/usr/bin/env python
# Copyright © 2026 Apple Inc.

import os
import sys
import subprocess

# ========================================
# SDK Configuration for Apple Platforms
# ========================================
try:
    _xcode_dev = subprocess.check_output(["xcode-select", "-p"]).decode().strip()
    xcode_path = _xcode_dev.removesuffix("/Contents/Developer")
except (subprocess.CalledProcessError, OSError):
    xcode_path = "/Applications/Xcode.app"

# Detect platform early for SDK configuration
platform = ARGUMENTS.get("platform", "macos" if sys.platform == "darwin" else "")

# Configure platform-specific SDK paths
if platform == "ios" and "IOS_SDK_PATH" not in ARGUMENTS:
    try:
        sdk_path = subprocess.check_output(["xcrun", "--sdk", "iphoneos", "--show-sdk-path"]).decode().strip()
        if os.path.exists(sdk_path):
            ARGUMENTS["IOS_SDK_PATH"] = sdk_path
    except (subprocess.CalledProcessError, OSError):
        pass

    ARGUMENTS["IOS_TOOLCHAIN_PATH"] = os.path.join(
        xcode_path, "Contents/Developer/Toolchains/XcodeDefault.xctoolchain"
    )
    ARGUMENTS["ios_min_version"] = "18.0"

elif platform == "visionos" and "VISIONOS_SDK_PATH" not in ARGUMENTS:
    try:
        sdk_path = subprocess.check_output(["xcrun", "--sdk", "xros", "--show-sdk-path"]).decode().strip()
        if os.path.exists(sdk_path):
            ARGUMENTS["VISIONOS_SDK_PATH"] = sdk_path
    except (subprocess.CalledProcessError, OSError):
        pass

    ARGUMENTS["VISIONOS_TOOLCHAIN_PATH"] = os.path.join(
        xcode_path, "Contents/Developer/Toolchains/XcodeDefault.xctoolchain"
    )
    ARGUMENTS["visionos_min_version"] = "26.0"

elif platform == "tvos" and "TVOS_SDK_PATH" not in ARGUMENTS:
    try:
        sdk_path = subprocess.check_output(["xcrun", "--sdk", "appletvos", "--show-sdk-path"]).decode().strip()
        if os.path.exists(sdk_path):
            ARGUMENTS["TVOS_SDK_PATH"] = sdk_path
    except (subprocess.CalledProcessError, OSError):
        pass

    ARGUMENTS["TVOS_TOOLCHAIN_PATH"] = os.path.join(
        xcode_path, "Contents/Developer/Toolchains/XcodeDefault.xctoolchain"
    )
    ARGUMENTS["tvos_min_version"] = "18.0"

elif platform == "macos" and "macos_sdk_path" not in ARGUMENTS:
    try:
        sdk_path = subprocess.check_output(["xcrun", "--sdk", "macosx", "--show-sdk-path"]).decode().strip()
        if os.path.exists(sdk_path):
            ARGUMENTS["macos_sdk_path"] = sdk_path
    except (subprocess.CalledProcessError, OSError):
        pass
    ARGUMENTS["macos_deployment_target"] = "15.0"

# ========================================
# Initialize godot-cpp
# ========================================
# Check if godot-cpp library already exists to avoid unnecessary rebuilds
arch = ARGUMENTS.get("arch", "arm64")
target = ARGUMENTS.get("target", "template_debug")
sim = ".simulator" if ARGUMENTS.get(f"{platform}_simulator") == "yes" else ""
godot_cpp_lib = f"godot-cpp/bin/libgodot-cpp.{platform}.{target}.{arch}{sim}.a"

# Allow forcing rebuild with --rebuild-godot-cpp flag
rebuild_godot_cpp = ARGUMENTS.get("rebuild_godot_cpp", "no") == "yes"

if os.path.exists(godot_cpp_lib) and not rebuild_godot_cpp:
    print(f"Using existing godot-cpp: {godot_cpp_lib}")
    ARGUMENTS["build_library"] = "no"
elif not os.path.exists(godot_cpp_lib):
    print(f"godot-cpp not found, building: {godot_cpp_lib}")
else:
    print(f"Rebuilding godot-cpp: {godot_cpp_lib}")

# Add custom platform tools for visionOS and tvOS support
if "custom_tools" not in ARGUMENTS:
    ARGUMENTS["custom_tools"] = os.path.abspath("tools")

env = SConscript("godot-cpp/SConstruct")

print(f"Building for architecture: {env.get('arch', 'default')}")
print(f"Target platform: {env['platform']}")

# ========================================
# Compiler Configuration
# ========================================
# Enable Objective-C++ with ARC for PHASE integration
env.Append(CXXFLAGS=["-fobjc-arc", "-x", "objective-c++"])
env["CXX"] = "clang++"

# Include paths
env.Append(CPPPATH=[
    "src",
    "PHASEWrapper"
])

# Link Apple frameworks required by PHASE
env.Append(LINKFLAGS=[
    "-framework", "Foundation",
    "-framework", "PHASE",
    "-framework", "Accelerate",
    "-framework", "ModelIO",
    "-framework", "AVFoundation",
    "-lobjc"
])

# ========================================
# Source Files
# ========================================
is_simulator = env.get(f"{env['platform']}_simulator", False)
sim_suffix = ".simulator" if is_simulator else ""
build_dir = f"build/{env['platform']}.{env['target']}.{env['arch']}{sim_suffix}"
VariantDir(f"{build_dir}/src", "src", duplicate=0)
VariantDir(f"{build_dir}/PHASEWrapper", "PHASEWrapper", duplicate=0)

sources = [
    f"{build_dir}/src/PHASEAudioListener3D.cpp",
    f"{build_dir}/src/PHASEOccluder3D.cpp",
    f"{build_dir}/src/PHASEManager.cpp",
    f"{build_dir}/src/PHASEAudioStreamPlayer3D.cpp",
    f"{build_dir}/src/PHASEAudioStreamPlayer3DInternal.cpp",
    f"{build_dir}/src/register_types.cpp",
]

phasewrapper_sources = [
    f"{build_dir}/PHASEWrapper/PHASEWrapper.mm",
    f"{build_dir}/PHASEWrapper/PHASEWrapperRingBuffer.mm",
]

# Build PHASEWrapper as target-specific static library
# Use target-specific filename to distinguish debug/release builds
phase_lib_name = f"demo/bin/libphasewrapper.{env['target']}"
phase_lib = env.StaticLibrary(phase_lib_name, source=phasewrapper_sources)

# ========================================
# Platform-Specific Build Configuration
# ========================================
if env["platform"] == "macos":
    if "macos_sdk_path" in ARGUMENTS:
        sdk_path = ARGUMENTS.get("macos_sdk_path")
    else:
        try:
            sdk_path = subprocess.check_output(["xcrun", "--sdk", "macosx", "--show-sdk-path"]).decode().strip()
        except (subprocess.CalledProcessError, OSError):
            sdk_path = ""

    if sdk_path:
        env.Append(CXXFLAGS=["-isysroot", sdk_path, "-mmacosx-version-min=15.0"])
        env.Append(LINKFLAGS=["-isysroot", sdk_path, "-mmacosx-version-min=15.0"])

    # Build shared library framework for macOS
    library = env.SharedLibrary(
        "demo/bin/libphasegodot.{}.{}.framework/libphasegodot.{}.{}".format(
            env["platform"], env["target"], env["platform"], env["target"]
        ),
        source=sources,
        LIBS=env["LIBS"] + [phase_lib]
    )

elif env["platform"] in ["ios", "visionos", "tvos"]:
    # iOS/visionOS/tvOS use static libraries merged with libtool
    # Platform-specific min-version flags are set by godot-cpp platform tools (ios.py, visionos.py, tvos.py)

    godot_cpp_lib = f"godot-cpp/bin/libgodot-cpp.{env['platform']}.{env['target']}.{env['arch']}{sim_suffix}.a"
    output_lib = f"demo/bin/libphasegodot.{env['platform']}.{env['target']}{sim_suffix}.a"

    # Build temporary static library
    temp_lib = env.StaticLibrary(
        f"demo/bin/libphasegodot_temp.{env['platform']}.{env['target']}{sim_suffix}",
        source=sources
    )

    # Merge all static libraries (godot-cpp, PHASEWrapper, and our code)
    phase_lib_path = f"demo/bin/libphasewrapper.{env['target']}"
    merge_cmd = f"libtool -static -o {output_lib} ${{SOURCE.abspath}} {phase_lib_path} {godot_cpp_lib}"
    library = env.Command(output_lib, [temp_lib, phase_lib, godot_cpp_lib], merge_cmd)

else:
    # Fallback for other platforms
    library = env.SharedLibrary(
        "demo/bin/libphasegodot{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
        source=sources
    )

Default(library)
