[configuration]

entry_symbol = "godotphase_library_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]

macos.debug = "res://bin/libphasegodot.macos.template_debug.framework"
macos.release = "res://bin/libphasegodot.macos.template_release.framework"
ios.debug = "res://bin/libphasegodot.ios.template_debug.a"
ios.release = "res://bin/libphasegodot.ios.template_release.a"
tvos.debug = "res://bin/libphasegodot.tvos.template_debug.a"
tvos.release = "res://bin/libphasegodot.tvos.template_release.a"
visionos.debug = "res://bin/libphasegodot.visionos.template_debug.a"
visionos.release = "res://bin/libphasegodot.visionos.template_release.a"