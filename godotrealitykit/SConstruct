"""
SConstruct for GodotRealityKit - builds the GDExtension framework and addon.

Usage:
    scons                                # Build everything (deps if needed, frameworks, addon, docs)
    scons deps                           # Clone and build godot + godot-cpp only
    scons framework platform=macos       # Build macOS framework only
    scons framework platform=visionos    # Build visionOS device framework only
    scons framework platform=visionos simulator=yes  # Build Simulator framework only
    scons addon                          # Assemble addon for distribution
    scons docs                           # Regenerate doc_data.gen.cpp and rebuild frameworks

Dependency URLs/branches are read from deps.conf (or overridden via env vars).
"""

import os
import sys
import subprocess
import shutil
import tempfile
import zipfile

from SCons.Variables import BoolVariable

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------

env = Environment(ENV=os.environ.copy())

REPO_DIR = Dir('.').abspath
OUT_DIR = os.path.join(REPO_DIR, 'out')
WORKSPACE = os.path.join(OUT_DIR, 'workspace')
LOCAL_SHARED_WORKSPACE = os.path.join(OUT_DIR, 'shared_workspace')

# ---------------------------------------------------------------------------
# Read dependency configuration from deps.conf, env vars override
# ---------------------------------------------------------------------------

def read_deps_conf():
    """Read key=value pairs from deps.conf."""
    conf = {}
    conf_path = os.path.join(REPO_DIR, 'deps.conf')
    if os.path.exists(conf_path):
        with open(conf_path) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith('#'):
                    continue
                if '=' in line:
                    k, v = line.split('=', 1)
                    conf[k.strip()] = v.strip()
    return conf

_deps_conf = read_deps_conf()

# deps.conf supports two modes:
#   1. SHARED_WORKSPACE=<path> — use an existing workspace with pre-built deps
#   2. GODOT_URL/GODOT_BRANCH/GODOT_CPP_URL/GODOT_CPP_BRANCH — clone and build
EXTERNAL_SHARED_WORKSPACE = os.environ.get('SHARED_WORKSPACE', _deps_conf.get('SHARED_WORKSPACE', ''))

GODOT_URL = os.environ.get('GODOT_URL', _deps_conf.get('GODOT_URL', ''))
GODOT_BRANCH = os.environ.get('GODOT_BRANCH', _deps_conf.get('GODOT_BRANCH', ''))
GODOT_CPP_URL = os.environ.get('GODOT_CPP_URL', _deps_conf.get('GODOT_CPP_URL', ''))
GODOT_CPP_BRANCH = os.environ.get('GODOT_CPP_BRANCH', _deps_conf.get('GODOT_CPP_BRANCH', ''))

if EXTERNAL_SHARED_WORKSPACE:
    SHARED_WORKSPACE = os.path.abspath(EXTERNAL_SHARED_WORKSPACE)
else:
    SHARED_WORKSPACE = LOCAL_SHARED_WORKSPACE
DEPS_DIR = os.path.join(SHARED_WORKSPACE, 'deps')

# ---------------------------------------------------------------------------
# User-configurable variables
# ---------------------------------------------------------------------------

platform_arg = ARGUMENTS.get('platform', 'macos')
config_arg = ARGUMENTS.get('config', ARGUMENTS.get('deps_config', 'debug')).lower()
deps_config = ARGUMENTS.get('deps_config', config_arg).lower()
options = Variables()
options.Add(BoolVariable('simulator', 'Build the visionOS Simulator framework', False))
options.Update(env)
simulator_arg = env['simulator']

if config_arg not in ('debug', 'release') or deps_config not in ('debug', 'release'):
    print('ERROR: config and deps_config must be debug or release')
    Exit(1)
if platform_arg not in ('macos', 'visionos') or (simulator_arg and platform_arg != 'visionos'):
    print('ERROR: simulator=yes requires platform=visionos; supported platforms are macos and visionos')
    Exit(1)

SCONS = [sys.executable, '-m', 'SCons', '-j', str(GetOption('num_jobs'))]

# Keep godot-cpp's target aligned with the framework's configured minimum OS.
with open(os.path.join(REPO_DIR, 'GodotRealityKit', 'Configurations', 'Config.xcconfig')) as f:
    visionos_min_version = next(line.split('=', 1)[1].strip() for line in f
                               if line.startswith('XROS_DEPLOYMENT_TARGET ='))

DEVELOPER_DIR = os.environ.get('DEVELOPER_DIR', subprocess.check_output(
    ['xcode-select', '-p']).decode().strip())
XCODEBUILD = os.path.join(DEVELOPER_DIR, 'usr', 'bin', 'xcodebuild')

# ---------------------------------------------------------------------------
# Path helpers
# ---------------------------------------------------------------------------

def godot_deps_dir():
    return os.path.join(DEPS_DIR, deps_config)

def godot_dir():
    return os.path.join(godot_deps_dir(), 'godot')

def godot_cpp_dir():
    return os.path.join(godot_deps_dir(), 'godot-cpp')

def framework_platform_name():
    return 'macOS' if platform_arg == 'macos' else ('visionOS-Simulator' if simulator_arg else 'visionOS')

def framework_build_dir():
    pname = framework_platform_name()
    cname = config_arg.capitalize()
    return os.path.join(WORKSPACE, 'build', pname, cname)

# ---------------------------------------------------------------------------
# deps: clone and build godot + godot-cpp
# ---------------------------------------------------------------------------

def prepare_checkout(url, branch, dest):
    # Existing dependency checkouts may contain local engine work. Rebuild them
    # in place; only select the configured revision for a new checkout.
    if not os.path.isdir(dest):
        subprocess.check_call(['git', 'clone', url, dest])
        subprocess.check_call(['git', 'checkout', branch], cwd=dest)


def validate_visionos_template(path):
    with zipfile.ZipFile(path) as bundle:
        for platform in ('xros-arm64', 'xros-arm64-simulator'):
            name = 'libgodot.visionos.{}.xcframework/{}/libgodot.a'.format(config_arg, platform)
            if bundle.getinfo(name).file_size == 0:
                raise ValueError('Empty engine library: ' + name)


def missing_dependencies():
    dd = godot_deps_dir()
    required = [
        os.path.join(dd, 'extension_api.json'),
        os.path.join(godot_dir(), 'bin', 'godot.macos.editor.dev.arm64'),
        os.path.join(godot_dir(), 'bin', 'godot_macos.zip'),
        os.path.join(godot_cpp_dir(), 'bin', 'libgodot-cpp.macos.editor.universal.a'),
    ]
    for suffix in ('', '.simulator'):
        required.append(os.path.join(godot_dir(), 'bin', 'libgodot.visionos.template_{}.arm64{}.a'.format(config_arg, suffix)))
        required.append(os.path.join(godot_cpp_dir(), 'bin', 'libgodot-cpp.visionos.template_{}.arm64{}.a'.format(config_arg, suffix)))
    missing = [path for path in required if not os.path.isfile(path)]
    template = os.path.join(godot_dir(), 'bin', 'godot_visionos.zip')
    try:
        validate_visionos_template(template)
    except (OSError, KeyError, ValueError, zipfile.BadZipFile):
        missing.append(template + ' (requires both device and Simulator libraries)')
    return missing


def build_godot(target_env):
    dd = godot_deps_dir()
    os.makedirs(dd, exist_ok=True)
    gdir = godot_dir()

    if not GODOT_URL or not GODOT_BRANCH:
        print("ERROR: GODOT_URL and GODOT_BRANCH environment variables must be set")
        Exit(1)

    prepare_checkout(GODOT_URL, GODOT_BRANCH, gdir)

    scons_cmds = [
        ['verbose=1', 'platform=macos', 'target=editor', 'generate_bundle=yes',
         'dev_build=yes', 'vulkan=false', 'disable_path_overrides=no'],
        ['verbose=1', 'platform=macos', 'target=template_' + config_arg,
         'generate_bundle=yes', 'vulkan=false', 'disable_path_overrides=no'],
    ]
    for simulator in ('no', 'yes'):
        scons_cmds.append([
            'verbose=1', 'platform=visionos', 'target=template_' + config_arg,
            'simulator=' + simulator, 'arch=arm64', 'generate_bundle=yes',
            'compiledb=yes', 'vulkan=false',
            'SWIFT_FRONTEND=' + os.path.join(REPO_DIR, 'scripts', 'build', 'swift-frontend-wrapper.sh'),
        ])

    # Godot generates shared headers, so finish each platform before starting
    # the next. The final bundle includes both visionOS library variants.
    for args in scons_cmds:
        subprocess.check_call(SCONS + args, cwd=gdir)

    # Dump extension API
    editor_bin = os.path.join(gdir, 'bin', 'godot.macos.editor.dev.arm64')
    subprocess.check_call([editor_bin, '--dump-extension-api'], cwd=dd)

def build_godot_cpp(target_env):
    dd = godot_deps_dir()
    cppdir = godot_cpp_dir()

    if not GODOT_CPP_URL or not GODOT_CPP_BRANCH:
        print("ERROR: GODOT_CPP_URL and GODOT_CPP_BRANCH environment variables must be set")
        Exit(1)

    prepare_checkout(GODOT_CPP_URL, GODOT_CPP_BRANCH, cppdir)
    ext_api = os.path.join(dd, 'extension_api.json')
    tools_dir = os.path.join(REPO_DIR, 'tools')

    common = ['custom_api_file=' + ext_api, 'use_hot_reload=no']
    scons_cmds = [
        ['platform=macos', 'target=editor'] + common,
        ['platform=macos', 'target=template_' + config_arg] + common,
    ]
    for simulator in ('no', 'yes'):
        scons_cmds.append([
            'platform=visionos', 'target=template_' + config_arg,
            'ios_simulator=' + simulator, 'arch=arm64',
            'visionos_min_version=' + visionos_min_version, 'custom_tools=' + tools_dir,
        ] + common)

    for args in scons_cmds:
        subprocess.check_call(SCONS + args, cwd=cppdir)

    # Sign the macOS editor library
    editor_lib = os.path.join(cppdir, 'bin', 'libgodot-cpp.macos.editor.universal.a')
    if os.path.exists(editor_lib):
        subprocess.check_call(['codesign', '-s', '-', '-f', '-v', editor_lib])

    # Create template symlink
    bindir = os.path.join(cppdir, 'bin')
    template_link = os.path.join(bindir, 'libgodot-cpp.visionos.template.arm64.a')
    template_src = 'libgodot-cpp.visionos.template_{}.arm64.a'.format(config_arg)
    if os.path.islink(template_link):
        os.unlink(template_link)
    if not os.path.exists(template_link):
        os.symlink(template_src, template_link)

def deps_action(target, source, env):
    if EXTERNAL_SHARED_WORKSPACE:
        missing = missing_dependencies()
        if missing:
            print('ERROR: SHARED_WORKSPACE uses pre-built dependencies; missing:\n  ' + '\n  '.join(missing))
            print('Build both visionOS targets in that workspace, or unset SHARED_WORKSPACE to build local dependencies.')
            return 1
        print('Using pre-built device and Simulator dependencies: ' + godot_deps_dir())
        return 0
    build_godot(env)
    build_godot_cpp(env)
    missing = missing_dependencies()
    if missing:
        print('ERROR: Dependency build did not produce:\n  ' + '\n  '.join(missing))
        return 1
    return 0

deps_builder = env.Command('deps_marker', [], deps_action)
env.Alias('deps', deps_builder)
env.AlwaysBuild(deps_builder)

# ---------------------------------------------------------------------------
# framework: xcodebuild the GodotRealityKit framework
# ---------------------------------------------------------------------------

def resolve_xcode_destination():
    if platform_arg == 'macos':
        return 'generic/platform=macOS'
    elif platform_arg == 'visionos':
        return 'generic/platform=visionOS Simulator' if simulator_arg else 'generic/platform=visionOS'
    else:
        print("ERROR: Unsupported platform '{}'".format(platform_arg))
        Exit(1)

def resolve_xcode_products_subdir():
    xcode_config = config_arg.capitalize()
    if platform_arg == 'macos':
        return xcode_config
    elif platform_arg == 'visionos':
        return '{}-{}'.format(xcode_config, 'xrsimulator' if simulator_arg else 'xros')
    return xcode_config

def build_framework_action(target, source, env):
    # Create deps symlink that the Xcode project expects at $(SRCROOT)/../deps/
    deps_link = os.path.join(REPO_DIR, 'deps')
    deps_target = godot_deps_dir()
    if os.path.islink(deps_link):
        os.unlink(deps_link)
    elif os.path.exists(deps_link):
        os.remove(deps_link)
    os.symlink(deps_target, deps_link)

    xcode_config = config_arg.capitalize()
    destination = resolve_xcode_destination()
    build_dir = os.path.join(SHARED_WORKSPACE, 'xcodebuild', '{}-{}'.format(
        framework_platform_name(), xcode_config), 'build')
    os.makedirs(build_dir, exist_ok=True)

    subprocess.check_call([
        XCODEBUILD, 'build',
        '-derivedDataPath', build_dir,
        '-project', os.path.join(REPO_DIR, 'GodotRealityKit', 'GodotRealityKit.xcodeproj'),
        '-scheme', 'GodotRealityKit',
        '-configuration', xcode_config,
        '-destination', destination,
        '-sdk', 'macosx' if platform_arg == 'macos' else ('xrsimulator' if simulator_arg else 'xros'),
        '-jobs', str(GetOption('num_jobs')),
    ])

    products_subdir = resolve_xcode_products_subdir()
    built_framework = os.path.join(
        build_dir, 'Build', 'Products', products_subdir, 'GodotRealityKit.framework')

    out_dir = framework_build_dir()
    os.makedirs(out_dir, exist_ok=True)
    dest_framework = os.path.join(out_dir, 'GodotRealityKit.framework')
    if os.path.exists(dest_framework):
        shutil.rmtree(dest_framework)
    shutil.copytree(built_framework, dest_framework, symlinks=True)

    return 0

framework_builder = env.Command('framework_marker', [], build_framework_action)
env.Alias('framework', framework_builder)
env.AlwaysBuild(framework_builder)

# ---------------------------------------------------------------------------
# addon: assemble the distributable addon package
# ---------------------------------------------------------------------------

def build_addon_action(target, source, env):
    assemble_full_addon(config_arg)
    return 0

addon_builder = env.Command('addon_marker', [], build_addon_action)
env.Alias('addon', addon_builder)
env.AlwaysBuild(addon_builder)

# ---------------------------------------------------------------------------
# docs: build editor documentation
# ---------------------------------------------------------------------------

def build_docs_action(target, source, env):
    cfg = config_arg
    dd = godot_deps_dir()

    # Generate GodotRealityKit/gen/doc_data.gen.cpp from doc_classes/*.xml.
    subprocess.check_call([
        *SCONS,
        'repo_dir={}'.format(REPO_DIR),
        'deps_dir={}'.format(dd),
    ], cwd=os.path.join(REPO_DIR, 'scripts', 'editor-documentation'))

    # Rebuild the frameworks so the regenerated doc data gets linked in via
    # the Xcode project's filesystem-synchronized `gen/` group. Without this,
    # editing a doc_classes XML and running `scons docs` would update the
    # generated cpp but leave the previously built framework binaries stale.
    for platform, simulator in (('macos', 'no'), ('visionos', 'no'), ('visionos', 'yes')):
        subprocess.check_call(SCONS + [
            'framework', 'platform=' + platform, 'simulator=' + simulator,
            'config=' + cfg, 'deps_config=' + deps_config,
        ], cwd=REPO_DIR)
    return 0

docs_builder = env.Command('docs_marker', [], build_docs_action)
env.Alias('docs', docs_builder)
env.AlwaysBuild(docs_builder)

# ---------------------------------------------------------------------------
# default: build full addon with macOS editor + visionOS template
# ---------------------------------------------------------------------------

def assemble_full_addon(cfg):
    """Package macOS plus device/Simulator visionOS frameworks and templates."""
    gd = godot_dir()
    macos_fw = os.path.join(WORKSPACE, 'build', 'macOS', cfg.capitalize(), 'GodotRealityKit.framework')
    device_fw = os.path.join(WORKSPACE, 'build', 'visionOS', cfg.capitalize(), 'GodotRealityKit.framework')
    simulator_fw = os.path.join(WORKSPACE, 'build', 'visionOS-Simulator', cfg.capitalize(), 'GodotRealityKit.framework')
    macos_zip = os.path.join(gd, 'bin', 'godot_macos.zip')
    visionos_zip = os.path.join(gd, 'bin', 'godot_visionos.zip')
    for path in (macos_fw, device_fw, simulator_fw, macos_zip, visionos_zip):
        if not os.path.exists(path):
            raise RuntimeError('Missing build output: ' + path + '. Run scons first.')
    validate_visionos_template(visionos_zip)

    addon_parent = os.path.join(OUT_DIR, 'addons')
    os.makedirs(addon_parent, exist_ok=True)
    # Finish packaging before replacing the previous working addon.
    with tempfile.TemporaryDirectory(prefix='.GodotRealityKit-', dir=addon_parent) as stage:
        ad = os.path.join(stage, 'GodotRealityKit')
        os.makedirs(ad)
        etc_dir = os.path.join(REPO_DIR, 'etc')
        for name in ('plugin.cfg', 'GodotRealityKit.gdextension', 'gdrk.gd', 'gdrk_export.gd'):
            shutil.copy2(os.path.join(etc_dir, name), ad)
        for name in ('volume_camera_gizmo', 'directional_light_shadow_gizmo', 'clipping_gizmo'):
            shutil.copytree(os.path.join(etc_dir, name), os.path.join(ad, name))

        editor_dir = os.path.join(ad, 'macos.editor')
        os.makedirs(editor_dir)
        shutil.copytree(macos_fw, os.path.join(editor_dir, 'GodotRealityKit.framework'), symlinks=True)
        shutil.copy2(macos_zip, editor_dir)
        os.symlink('macos.editor', os.path.join(ad, 'macos.template_' + cfg))

        template_dir = os.path.join(ad, 'visionos.template_' + cfg)
        os.makedirs(template_dir)
        subprocess.check_call([
            XCODEBUILD, '-create-xcframework',
            '-framework', device_fw, '-framework', simulator_fw,
            '-output', os.path.join(template_dir, 'GodotRealityKit.xcframework'),
        ])
        shutil.copy2(visionos_zip, template_dir)

        destination = os.path.join(addon_parent, 'GodotRealityKit')
        if os.path.exists(destination):
            shutil.rmtree(destination)
        shutil.move(ad, destination)
    print('Addon built at: ' + destination)

def build_default_action(target, source, env):
    cfg = config_arg
    dd = godot_deps_dir()
    if missing_dependencies():
        urls_configured = GODOT_URL and GODOT_CPP_URL
        if not urls_configured and not EXTERNAL_SHARED_WORKSPACE:
            print('')
            print('Dependencies are not available and repository URLs are not configured.')
            print('To build GodotRealityKit, configure deps.conf (or set environment variables):')
            print('')
            print('  SHARED_WORKSPACE - Path to an existing shared workspace with pre-built deps')
            print('')
            print('Or specify repository URLs to clone and build from source:')
            print('')
            print('  GODOT_URL      - Git URL for your Godot fork')
            print('  GODOT_CPP_URL  - Git URL for your godot-cpp fork')
            print('')
            print('Then run:  scons')
            print('Or:        scons deps   (to fetch dependencies only)')
            print('')
            return 0
        subprocess.check_call(SCONS + ['deps', 'config=' + cfg, 'deps_config=' + deps_config], cwd=REPO_DIR)

    # `scons docs` regenerates doc_data.gen.cpp from doc_classes/*.xml AND
    # rebuilds all three frameworks so the doc data is linked into the binaries
    # via the Xcode project's filesystem-synchronized `gen/` group.
    subprocess.check_call(SCONS + ['docs', 'config=' + cfg, 'deps_config=' + deps_config], cwd=REPO_DIR)
    assemble_full_addon(cfg)
    return 0

default_builder = env.Command('default_marker', [], build_default_action)
env.AlwaysBuild(default_builder)

# Default target
Default(default_builder)
